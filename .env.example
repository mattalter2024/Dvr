# AirVault DVR Server Configuration
PORT=8096
HOST=0.0.0.0
DATA_DIR=./data
RECORDINGS_DIR=./recordings

# Media & Commercial Skip Tools (auto-detected from PATH if omitted)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
COMSKIP_PATH=comskip
COMSKIP_INI_PATH=./server/comskip.ini

# Optional initial XMLTV EPG URL (can also be configured in the Settings UI)
XMLTV_URL=

# Enable built-in Virtual OTA Tuner Simulator on first launch for zero-hardware testing
ENABLE_VIRTUAL_TUNER=true
VIRTUAL_TUNER_COUNT=2

# Auto-run commercial detection after recordings finish
AUTO_COMMERCIAL_SCAN=true

# LAN discovery UDP beacon port (used by Android TV / Fire TV app)
DISCOVERY_UDP_PORT=41234
SERVER_NAME=AirVault Home DVR
